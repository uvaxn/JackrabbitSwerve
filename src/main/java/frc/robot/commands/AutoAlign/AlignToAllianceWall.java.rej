+     * only -- there's nothing here for vision to correct.
+     */
+    public static Rotation2d computeTargetDirection() {
+        return Rotation2d.fromRadians(
+            DriverStation.getAlliance().orElse(Alliance.Blue) == Alliance.Red
+                ? 0.0
+                : Math.PI);
+    }
